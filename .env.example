# ---------------------------------------------------------------------------
# Server-side. No VITE_ prefix, so these never reach the browser bundle.
# ---------------------------------------------------------------------------

# Google Apps Script web app URL that records RSVPs into the sheet.
# Read by api/rsvp.ts on Vercel, and by the matching dev endpoint in
# vite.config.ts so `npm run dev` behaves the same way.
# In production, set this in the Vercel dashboard (Settings → Environment
# Variables), NOT in a committed file.
RSVP_ENDPOINT=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXX/exec

# ---------------------------------------------------------------------------
# Client-side. The VITE_ prefix means these ARE visible in the browser bundle.
# Only put values here that are safe to publish.
# ---------------------------------------------------------------------------

# Optional. The Share button normally sends whatever address the invitation is
# open at, so hosting it anywhere just works. Set this only to force a specific
# address — for example when the site also answers on a preview domain, or to
# put the right link in the WhatsApp preview. No trailing slash.
# VITE_SITE_URL=https://adithya-vishnuraj.example.com
