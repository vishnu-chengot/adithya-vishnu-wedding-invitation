# Google Apps Script web app URL that records RSVPs into the sheet.
# Deploy google-apps-script/Code.gs as a web app and paste its /exec URL here.
# Copy this file to .env.local for development; set the same variable in your
# host's environment for the deployed site.
VITE_RSVP_ENDPOINT=https://script.

# Optional. The Share button normally sends whatever address the invitation is
# open at, so hosting it anywhere just works. Set this only to force a specific
# address — for example when the site also answers on a preview domain, or to
# put the right link in the WhatsApp preview. No trailing slash.
# VITE_SITE_URL=https://adithya-vishnuraj.example.com
